@@ -0,0 +1,103 @@
+"""Capture the existing discrete rollout and reverse sweep as graph launches.
+
+The eager field operations are captured across the entire loop. The same
+Euler/Heun operations and VJPs run, with the same summation order and dtypes.
+Only CPU dispatch is removed; no derivative or sampling step is dropped.
+"""
+import torch
+from torch.autograd.function import once_differentiable
+from .sampler import _Rollout
+
+
+class _Saved:
+    """Minimal capture-time context for the existing rollout implementation."""
+    needs_input_grad = (False, True)
+
+    def save_for_backward(self, *tensors):
+        self.saved_tensors = tensors
+
+
+class _GraphRollout(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, owner, noise, labels, *parameters):
+        owner.check(noise, labels)
+        owner.noise.copy_(noise)
+        owner.labels.copy_(labels)
+        owner.forward_graph.replay()
+        # Save *copies*: a second forward must not overwrite the first tape.
+        ctx.owner = owner
+        ctx.save_for_backward(labels, owner.tape.clone(), *parameters)
+        return owner.output.clone()
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, gradient):
+        labels, tape, *_ = ctx.saved_tensors  # parameter version checks
+        owner = ctx.owner
+        owner.check_stream()
+        owner.labels.copy_(labels)
+        owner.tape.copy_(tape)
+        owner.cotangent.copy_(gradient)
+        owner.backward_graph.replay()
+        values = tuple(None if x is None else x.clone() for x in owner.derivatives)
+        return (None, values[0] if ctx.needs_input_grad[1] else None, None, *values[1:])
+
+
+class TrajectoryReplay:
+    """Fixed-shape, single-stream replay with independently saved call tapes.
+
+    A graph's outputs never escape without a clone. Forward/backward use
+    separate private pools. Parameters
+    may be updated in place between completed forward/backward pairs.
+    """
+
+    def __init__(self, engine, example, labels):
+        if engine.replay.graphs:
+            raise ValueError('Capture eager fields, not nested PyTorch graph replays')
+        self.engine = engine
+        self.noise, self.labels = example.detach().clone(), labels.clone()
+        self.cotangent = torch.ones_like(example)
+        self.stream = torch.cuda.current_stream(example.device)
+        n = len(engine.active)
+        self.tape = example.new_empty((n*(2 if engine.heun else 1), *example.shape))
+        self.forward_graph, self.backward_graph = torch.cuda.CUDAGraph(), torch.cuda.CUDAGraph()
+        capture_stream = torch.cuda.Stream()
+        capture_stream.wait_stream(self.stream)
+
+        def forward():
+            saved = _Saved()
+            result = _Rollout.forward(saved, engine, self.noise, self.labels, *engine.parameters)
+            for target, source in zip(self.tape.unbind(), saved.saved_tensors[1:1+len(self.tape)]):
+                target.copy_(source)
+            return result
+
+        def backward():
+            saved = _Saved()
+            saved.engine = engine
+            saved.saved_tensors = (self.labels, *self.tape.unbind(), *engine.parameters)
+            result = _Rollout.backward(saved, self.cotangent)
+            return (result[1], *result[3:])
+
+        with torch.cuda.stream(capture_stream), torch.no_grad():
+            # Warm all forward and reverse operators before capture.
+            forward()
+            backward()
+            with torch.cuda.graph(self.forward_graph, stream=capture_stream):
+                self.output = forward()
+            with torch.cuda.graph(self.backward_graph, stream=capture_stream):
+                self.derivatives = backward()
+        self.stream.wait_stream(capture_stream)
+
+    def check_stream(self):
+        if torch.cuda.current_stream(self.noise.device) != self.stream:
+            raise RuntimeError('Trajectory replay is bound to one CUDA stream')
+
+    def check(self, noise, labels):
+        self.check_stream()
+        self.engine.check_parameters(self.engine.parameters)
+        for actual, expected in ((noise, self.noise), (labels, self.labels)):
+            if (actual.shape, actual.dtype, actual.device) != (expected.shape, expected.dtype, expected.device):
+                raise ValueError('Trajectory inputs must match captured shape, dtype and device')
+
+    def __call__(self, noise, labels):
+        return _GraphRollout.apply(self, noise, labels, *self.engine.parameters)
