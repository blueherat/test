@@ -0,0 +1,43 @@
+"""Reuse deterministic frozen computations that do not depend on the state."""
+import torch
+
+
+def cache_time_embedding(adapter, grid, batch):
+    """Cache each fixed sampler time using the original batch shape and dtype.
+
+    Only valid inside this fixed-grid sampler: time is not a learned variable.
+    Labels are never cached. Per-time (not stacked-time) evaluation preserves
+    the original GEMM shapes and autocast rounding.
+    """
+    module = adapter.model.t_embedder
+    if module.training or any(p.requires_grad for p in module.parameters()):
+        raise ValueError('Time embedding must be frozen and in eval mode')
+    if hasattr(module, '_classifier_time_forward'):
+        raise ValueError('Build a fresh adapter before changing the cached grid')
+    original = module.forward
+    times = grid.detach().unique(sorted=True)
+    rae = adapter.name == 'raev2'
+    with torch.no_grad(), adapter.autocast():
+        outputs = [original(t.expand(batch), **({'return_base_embed': True} if rae else {})) for t in times]
+        tables = tuple(torch.stack([value[i] for value in outputs]) for i in range(2)) if rae else (torch.stack(outputs),)
+
+    def forward(t, return_base_embed=False):
+        if t.requires_grad or t.shape != (batch,):
+            raise ValueError('Cached embedding requires fixed-batch, fixed sampler times')
+        index = torch.searchsorted(times, t[:1].contiguous())
+        values = tuple(table.index_select(0, index).squeeze(0) for table in tables)
+        return values if rae and return_base_embed else values[-1]
+
+    module._classifier_time_forward = original
+    module.forward = forward
+    return sum(table.numel()*table.element_size() for table in tables)
+
+
+def skip_unused_rae_head(adapter):
+    """Use the upstream strong forward; the unused native IG output is dead code."""
+    if adapter.name != 'raev2':
+        raise ValueError('Only RAEv2 computes an unused native head here')
+    parent = type(adapter.model).__mro__[1]
+    if parent.__name__ != 'DiTwDDTHead':
+        raise ValueError('Unrecognized RAEv2 hierarchy')
+    adapter.strong_forward = lambda *args, **kwargs: parent.forward(adapter.model, *args, **kwargs)
