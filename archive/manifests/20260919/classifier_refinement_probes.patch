+class _StagedFeatures(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, decode, feature, latents):
+        images = decode(latents)
+        ctx.decode, ctx.feature = decode, feature
+        ctx.save_for_backward(latents, images)
+        return feature(images)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, gradient):
+        latents, images = ctx.saved_tensors
+        with torch.enable_grad():
+            images = images.detach().requires_grad_(True)
+            features = ctx.feature(images)
+            pixels_gradient, = torch.autograd.grad(features, images, gradient)
+        del features, images
+        with torch.enable_grad():
+            x = latents.detach().requires_grad_(True)
+            decoded = ctx.decode(x)
+            latent_gradient, = torch.autograd.grad(decoded, x, pixels_gradient)
+        return None, None, latent_gradient
+
+
+def staged_features(decode, feature, latents):
+    """Apply J_decode.T @ J_feature.T in separate, full-batch recomputations."""
+    return _StagedFeatures.apply(decode, feature, latents)
